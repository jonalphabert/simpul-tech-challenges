# Copy to .env to override the defaults used by docker-compose.yml.
POSTGRES_DB=delivery_planning
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Host ports
DB_PORT=5433
BACKEND_PORT=8000
FRONTEND_PORT=8080

# Production only (docker-compose.prod.yml): the domain Caddy serves over HTTPS
DOMAIN=planner.example.com
